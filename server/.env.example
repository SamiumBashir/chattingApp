# Node Environment
NODE_ENV=development
PORT=5000

# Client Application URL (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=https://chatting-app-nine-sigma.vercel.app

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/connectly

# JWT Authentication Secrets (Must be at least 32 characters long)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here_12345
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Redis Adapter (Optional, for multi-instance horizontal scaling)
REDIS_URL=redis://localhost:6379

# SMTP Email Service Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=Connectly <no-reply@connectly.app>

# WebRTC STUN & TURN Infrastructure (RFC 5766 Ephemeral HMAC-SHA1 Credentials or CoTURN)
TURN_SERVER_URL=turn:turn.connectly.app:3478
TURNS_SERVER_URL=turns:turn.connectly.app:5349
TURN_SECRET=your_turn_hmac_shared_secret_key_here
TURN_CREDENTIAL_TTL=86400
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.services.mozilla.com

# Metered.ca TURN Infrastructure
# Option A: Paste the ICE Servers Array JSON copied directly from your Metered Dashboard
# Example: METERED_ICE_SERVERS=[{"urls":"stun:stun.relay.metered.ca:80"},{"urls":["turn:standard.relay.metered.ca:80","turn:standard.relay.metered.ca:80?transport=tcp","turn:standard.relay.metered.ca:443","turns:standard.relay.metered.ca:443?transport=tcp"],"username":"...","credential":"..."}]
METERED_ICE_SERVERS=

# Option B: Dynamic Ephemeral Credentials via Metered REST API (Recommended for auto-rotation)
# Obtains temporary credentials from https://[domain].metered.ca/api/v1/turn/credentials?apiKey=[apiKey]
METERED_DOMAIN=
METERED_API_KEY=
METERED_API_CACHE_TTL=3600

# Option C: Static Credentials via Domain / Username / Credential
# METERED_DOMAIN=standard.relay.metered.ca
# METERED_USERNAME=your_metered_username
# METERED_CREDENTIAL=your_metered_credential_secret



