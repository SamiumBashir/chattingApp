# Node Environment
NODE_ENV=development
PORT=5000

# Client Application URL (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=https://chatting-app-nine-sigma.vercel.app

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/connectly

# JWT Authentication Secrets (Must be at least 32 characters long)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here_12345
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Redis Adapter (Optional, for multi-instance horizontal scaling)
REDIS_URL=redis://localhost:6379

# SMTP Email Service Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=Connectly <no-reply@connectly.app>

