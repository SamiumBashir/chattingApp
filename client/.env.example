# Connectly Client Environment Configuration

# Application Metadata
NEXT_PUBLIC_APP_NAME=Connectly

# Backend API & WebSocket Endpoints
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Google OAuth 2.0 Web Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# WebRTC STUN / TURN Configuration (Optional - falls back to Google STUN servers)
NEXT_PUBLIC_ICE_SERVERS=
NEXT_PUBLIC_TURN_SERVER=turn:turn.example.com:3478
NEXT_PUBLIC_TURN_USERNAME=connectly_turn_user
NEXT_PUBLIC_TURN_CREDENTIAL=connectly_turn_password

