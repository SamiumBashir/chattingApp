# Connectly Client Environment Configuration

# Application Metadata
NEXT_PUBLIC_APP_NAME=Connectly

# Backend API & WebSocket Endpoints
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Google OAuth 2.0 Web Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# WebRTC ICE Infrastructure:
# ICE servers (STUN and ephemeral TURN credentials) are automatically and securely
# fetched at runtime from the authenticated backend API (/api/v1/calls/ice-servers).
# Never expose permanent TURN secrets or credentials in client NEXT_PUBLIC_* variables.
#
# Optional Development/Testing: Force WebRTC to only route via TURN relay (disables direct P2P).
# Set to 'true' during local testing to verify cross-network NAT traversal without mobile devices.
# Must remain false or unset in production.
NEXT_PUBLIC_FORCE_TURN_RELAY=false



