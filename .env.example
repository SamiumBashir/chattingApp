# ==========================================
# CONNECTLY - MONOREPO ENVIRONMENT VARIABLES
# ==========================================

# -----------------
# FRONTEND (client/.env.local)
# -----------------
NEXT_PUBLIC_APP_NAME=Connectly
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# -----------------
# BACKEND (server/.env)
# -----------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/connectly
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT Authentication
JWT_ACCESS_SECRET=super_secret_access_jwt_key_32_characters_minimum_123456
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_32_characters_minimum_123456
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Redis / Upstash
REDIS_URL=redis://localhost:6379

# Email / SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="Connectly Team <no-reply@connectly.app>"

